# Salin menjadi .env lalu isi. Buat kunci acak dengan:  python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# ---- Database (pilih satu) ----
# 1) MySQL XAMPP (jalankan MySQL dari XAMPP Control Panel). Database "sinyal" dibuat otomatis.
DATABASE_URL=mysql://root:@127.0.0.1:3306/sinyal
# 2) SQLite tanpa server: kosongkan DATABASE_URL (file ada di folder instance/)
# DATABASE_URL=

# Ubah ke 1 hanya bila diakses lewat HTTPS
SESSION_COOKIE_SECURE=0
